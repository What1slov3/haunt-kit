{
  "name": "@haunt/ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./src/styles.ts",
    "./src/signal.ts"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles": "./src/styles.ts",
    "./signal": "./src/signal.ts",
    "./motion": "./src/motion/index.ts",
    "./fx": "./src/fx/index.ts",
    "./sound": "./src/sound/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:stories": "vitest run --project storybook",
    "test:watch": "vitest --project unit",
    "storybook": "storybook dev --port 6006 --no-open --disable-telemetry",
    "build:tui-font": "node scripts/tui-font.ts",
    "build:tokens": "node scripts/tokens.ts",
    "build-storybook": "storybook build --output-dir storybook-static --disable-telemetry",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:unit"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/big-shoulders-display": "^5.3.0",
    "@fontsource-variable/exo-2": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/oswald": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource-variable/tektur": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0"
  },
  "peerDependencies": {
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "peerDependenciesMeta": {
    "motion": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/addon-vitest": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser-playwright": "^4.1.12",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "motion": "^14.6.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "10.6.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  }
}
