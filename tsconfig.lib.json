{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    // Истории и документация импортируют кит по имени пакета — как его видит приложение
    "paths": {
      "@haunt/ui": ["./src/index.ts"],
      "@haunt/ui/styles": ["./src/styles.ts"],
      "@haunt/ui/motion": ["./src/motion/index.ts"],
      "@haunt/ui/signal": ["./src/signal.ts"],
      "@haunt/ui/fx": ["./src/fx/index.ts"],
      "@haunt/ui/sound": ["./src/sound/index.ts"]
    }
  },
  "include": ["src", ".storybook"]
}
